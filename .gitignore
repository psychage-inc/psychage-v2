scripts/content/.article-drafts-progress.json
# Workflow scaffold for citation retrofit (orchestration scratch, not app code)
scripts/content/wf-retrofit.js
# Citation-retrofit resume state (runtime, not source)
scripts/content/.retrofit-done.json
scripts/content/.retrofit-remaining.json

# Generated sitemaps (Phase 2 — generated by scripts/generate-sitemaps.ts)
public/sitemap-index.xml
public/sitemap-providers-*.xml
public/sitemap-pages.xml

# Supabase temp files
supabase/.temp/

# Bundled Vercel functions (generated by scripts/build-api.ts)
